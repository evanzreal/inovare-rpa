<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>inovare.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/macbook/inovare-rpa/start_tunnel.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macbook/inovare-rpa</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- URL pública fica visível neste log -->
    <key>StandardOutPath</key>
    <string>/Users/macbook/inovare-rpa/logs/tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macbook/inovare-rpa/logs/tunnel.log</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
